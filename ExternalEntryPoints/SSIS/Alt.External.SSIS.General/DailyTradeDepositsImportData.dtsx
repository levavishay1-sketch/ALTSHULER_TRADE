                          dataType="System.String"><![CDATA[using System;
using System.Collections.Generic;
using System.IO;
using System.Linq;
using System.Security.Cryptography;
using System.Text;
using System.Xml.Serialization;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    string[] peulot = new string[] {
        "175",
        "167",
        "671",
        "132",
        "701",
        "1155",
        "120",
        "121"
    };

    int rowCounter;

    public override void PreExecute()
    {
        base.PreExecute();
        rowCounter = 0;
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void CreateNewOutputRows()
    {
        var xmlList = (List<string>)ReadOnlyVariables["User::XmlList"].Value;
        var dateList = (List<DateTime>)ReadOnlyVariables["User::XmlDatesList"].Value;
        var fileNamesList = (List<string>)ReadOnlyVariables["User::XmlNamesList"].Value;

        for (int i = 0; i < xmlList.Count; i++)
        {
            string xml = xmlList[i];
            string xmlName = fileNamesList[i];
            DateTime xmlDate = dateList[i];

            PasZahav pasZahav;
            XmlSerializer serializer = new XmlSerializer(typeof(PasZahav));

            using (StringReader sr = new StringReader(xml))
            {
                pasZahav = (PasZahav)serializer.Deserialize(sr);
            }
            CleanObjectStrings(pasZahav);

            foreach (Nose nose in pasZahav.Lakoach.Noses)
            {
                if (nose.MezaheNose == "TnuatOshMatach")
                {
                    foreach (Reshuma reshuma in nose.Reshumot)
                    {
                        if (reshuma.MISPAR_CHESHBON == "573838" &&
                            reshuma.KOD_ZCHUT_CHOVA == "1" &&
                            reshuma.SUG_ISKA == "671")
                        {
                            CreateOutputRow(reshuma, nose, xmlDate, xmlName);
                        }
                    }
                }
                else if (nose.MezaheNose == "TnuotOsh")
                {
                    foreach (Reshuma reshuma in nose.Reshumot)
                    {
                        if (reshuma.MISPAR_CHESHBON == "573838")
                        {
                            if (reshuma.TEUR_PEULAT_OSH_Rev == Escape("העברת זה\"ב"))
                            {
                                CreateOutputRow(reshuma, nose, xmlDate, xmlName);
                            }
                            else if (peulot.Contains(reshuma.SUG_PEULA))
                            {
                                CreateOutputRow(reshuma, nose, xmlDate, xmlName);
                            }

                        }
                    }
                }
            }
        }
    }

    private void CreateOutputRow(Reshuma reshuma, Nose nose, DateTime xmlDate, string xmlName)
    {
        Output0Buffer.AddRow();

        rowCounter++;
        int? matbea = GetMatbea(reshuma, nose);

        if (nose.MezaheNose == "TnuotOsh")
        {
            if (reshuma.TEUR_PEULAT_OSH_Rev == Escape("העברת זה\"ב"))
            {
                Output0Buffer.CounterOrigAccount = reshuma.Counter_Orig_Account;
                if (reshuma.Counter_Orig_Account.Length >= 10)
                {
                    List<string> parts = new List<string>
                    {
                        reshuma.Counter_Orig_Account.Substring(4, 3),
                        reshuma.Counter_Orig_Account.Substring(7, 3),
                        reshuma.Counter_Orig_Account.Substring(10)
                    };

                    Output0Buffer.MISPARBANKNEGDI = parts[0].TrimStart('0');
                    Output0Buffer.MISPARSNIFNEGDI = parts[1].TrimStart('0');
                    Output0Buffer.MISPARCHESHBONNEGDI = parts[2].TrimStart('0');
                }
            }
            else
            {
                Output0Buffer.MISPARBANKNEGDI = reshuma.Mispar_Bank_Negdi;
                Output0Buffer.MISPARSNIFNEGDI = reshuma.Mispar_Snif_Negdi;
                Output0Buffer.MISPARCHESHBONNEGDI = reshuma.Mispar_Cheshbon_Negdi;
            }
        }
        else
        {
            Output0Buffer.MISPARBANKNEGDI = reshuma.MISPAR_BANK_NEGDI;
            Output0Buffer.MISPARSNIFNEGDI = reshuma.MISPAR_SNIF_NEGDI;
            Output0Buffer.MISPARCHESHBONNEGDI = reshuma.MISPAR_CHESHBON_NEGDI;
        }

        if (matbea.HasValue)
            Output0Buffer.KODMATBEA = matbea.Value;

        Output0Buffer.TAARICHERECH = DateTime.Parse(reshuma.TAARICH_ERECH);
        Output0Buffer.SCHUMTNUA = decimal.Parse(reshuma.SCHUM_TNUA);
        Output0Buffer.ASMACHTA = reshuma.ASMACHTA;
        Output0Buffer.SHURATTEXT72Rev = reshuma.SHURAT_TEXT_72_Rev;
        Output0Buffer.MISPARBANK = reshuma.MISPAR_BANK;
        Output0Buffer.MISPARSNIF = reshuma.MISPAR_SNIF;
        Output0Buffer.MISPARCHESHBON = reshuma.MISPAR_CHESHBON;
        Output0Buffer.XmlDate = xmlDate;
        Output0Buffer.XmlFileName = xmlName;

        if (nose.MezaheNose == "TnuotOsh")
        {
            Output0Buffer.Name = $"{nose.MezaheNose}-{reshuma.MISPAR_CHESHBON}-{reshuma.MISPAR_RATZ_TNUA}-{reshuma.TAARICH_ERECH}";
        }
        else if (nose.MezaheNose == "TnuatOshMatach")
        {
            Output0Buffer.Name = $"{nose.MezaheNose}-{reshuma.MISPAR_CHESHBON}-{reshuma.MISPAR_RATZ}-{reshuma.TAARICH_ERECH}";
        }

        string externalIdentifier = GenerateExternalIdentifier(reshuma, nose, matbea, xmlDate, xmlName);
        Output0Buffer.ExternalIdentifier = externalIdentifier;
    }

    private int? GetMatbea(Reshuma reshuma, Nose nose)
    {
        if (nose.MezaheNose == "TnuotOsh")
        {
            return 1;
        }
        else if (reshuma.KOD_MATBEA == "100")
        {
            return 2;
        }
        else if (reshuma.KOD_MATBEA == "19")
        {
            return 3;
        }
        return null;
    }

    private string GenerateExternalIdentifier(Reshuma reshuma, Nose nose, int? matbea, DateTime xmlDate, string xmlName)
    {
        string externalIdentifier = string.Empty;

        string input;
        if (nose.MezaheNose == "TnuotOsh")
        {
            input = reshuma.Mispar_Bank_Negdi + "|" + reshuma.Mispar_Snif_Negdi + "|" + reshuma.Mispar_Cheshbon_Negdi;
        }
        else
        {
            input = reshuma.MISPAR_BANK_NEGDI + "|" + reshuma.MISPAR_SNIF_NEGDI + "|" + reshuma.MISPAR_CHESHBON_NEGDI;
        }

        if (matbea.HasValue)
        {
            input += matbea.Value + "|";
        }

        input += reshuma.TAARICH_ERECH + "|" + reshuma.SCHUM_TNUA + "|" + reshuma.ASMACHTA + "|" +
            reshuma.SHURAT_TEXT_72_Rev + "|" + reshuma.MISPAR_BANK + "|" + reshuma.MISPAR_SNIF + "|" +
            reshuma.MISPAR_CHESHBON + "|" + xmlDate + "|" + xmlName + "|" + rowCounter;

        using (SHA256 sha = SHA256.Create())
        {
            byte[] hashBytes = sha.ComputeHash(Encoding.UTF8.GetBytes(input));
            externalIdentifier = BitConverter.ToString(hashBytes).Replace("-", "");
        }

        return externalIdentifier;
    }

    private void CleanObjectStrings(object obj)
    {
        if (obj == null)
            return;

        var type = obj.GetType();

        foreach (var prop in type.GetProperties())
        {
            if (prop.PropertyType == typeof(string))
            {
                var val = (string)prop.GetValue(obj);
                if (!string.IsNullOrWhiteSpace(val))
                    prop.SetValue(obj, Escape(val.Trim()));
            }
            else if (typeof(IEnumerable<object>).IsAssignableFrom(prop.PropertyType))
            {
                var list = prop.GetValue(obj) as System.Collections.IEnumerable;
                if (list != null)
                {
                    foreach (var item in list)
                        CleanObjectStrings(item);
                }
            }
            else if (!prop.PropertyType.IsPrimitive && !prop.PropertyType.IsEnum)
            {
                CleanObjectStrings(prop.GetValue(obj));
            }
        }
    }

    private string Escape(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "";

        value = value.Trim();

        if (value.Contains(",") || value.Contains("\"") || value.Contains("\n"))
        {
            value = value.Replace("\"", "\"\"");
            return $"\"{value}\"";
        }

        return value;
    }
}

public class PasZahav
