                          dataType="System.String"><![CDATA[using System;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void CreateNewOutputRows()
    {
        if (Variables.ScheduledOperationId != null && !string.IsNullOrWhiteSpace(Variables.ScheduledOperationId.ToString()))
        {
            Output0Buffer.AddRow();
            Output0Buffer.altscheduledoperationid = new Guid(Variables.ScheduledOperationId.ToString());
            Output0Buffer.altexecutionresult.AddBlobData(this.GetBytes(Variables.ExceptionMessageBlock));
            Output0Buffer.statecode = 0; // Active
            Output0Buffer.statuscode = 491170001; // Run
            Output0Buffer.altoperationruntime = (DateTime.Now - Variables.StartTime).ToString(@"dd\.hh\:mm\:ss\.f");
        }
    }

    private byte[] GetBytes(string str)
    {
        byte[] bytes = new byte[str.Length * sizeof(char)];
        System.Buffer.BlockCopy(str.ToCharArray(), 0, bytes, 0, bytes.Length);
        return bytes;
    }
}
]]></arrayElement>
