              <ProjectItem
                Name="ScriptMain.cs"
                Encoding="UTF8"><![CDATA[using System;
using System.Data;
using Microsoft.SqlServer.Dts.Runtime;
using System.Windows.Forms;

namespace ST_dd8968fa0c2c4f94b5e58ccd6839e14d
{
	[Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
	public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
	{
		public void Main()
		{
            string dataFlowName = Dts.Variables["User::DataFlowName"].Value.ToString();
            string counterRow = $"{{\"DataFlowName\":\"{dataFlowName}\",\"Created\":{Dts.Variables["User::CreateCounter"].Value},\"Updated\":{Dts.Variables["User::UpdateCounter"].Value},\"Pipeline\":{Dts.Variables["User::PipelineCounter"].Value},\"Errors\":{Dts.Variables["User::ErrorCounter"].Value}}}";

            string counters = Dts.Variables["User::ETLCountersMessageBlock"].Value.ToString();
            Dts.Variables["User::ETLCountersMessageBlock"].Value = string.IsNullOrWhiteSpace(counters) ?
                counterRow : $"{counters},{counterRow}";

            this.ResetCounters();

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        private void ResetCounters()
        {
            string[] vaiables =
            {
                "User::CreateCounter",
                "User::ErrorCounter",
                "User::PipelineCounter",
                "User::UpdateCounter"
            };
            foreach (var variable in vaiables)
            {
                Variables lockedVariables = null;
                Dts.VariableDispenser.LockOneForRead(variable, ref lockedVariables);
                lockedVariables[variable].Value = 0;
                lockedVariables.Unlock();
            }
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
	}
}]]></ProjectItem>
