                    <arrayElement
                      dataType="System.String"><![CDATA[using System.Collections.Generic;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
    }

    public override void CreateNewOutputRows()
    {
        string warnings = Variables.ETLWarningsMessageBlock;

        string[] splitedWarnings = warnings.Replace('{', ' ').Split('}');
        foreach (var warning in splitedWarnings)
        {
            List<string> values = new List<string>();
            string[] warningDetails = warning.Split(',');
            foreach (var item in warningDetails)
            {
                if (!string.IsNullOrWhiteSpace(item))
                {
                    string[] itemParts = item.Split(':');
                    if (itemParts.Length == 2)
                    {
                        values.Add(itemParts[1].ToString());
                    }

                }
            }
            this.AddRow(values);
        }
    }

    private void AddRow(List<string> values)
    {
        if (values.Count > 0)
        {
            Output0Buffer.AddRow();
            Output0Buffer.Column1 = values.Count >= 1 ? values[0] : null;
            Output0Buffer.Column2 = values.Count >= 2 ? values[1] : null;
            Output0Buffer.Column3 = values.Count >= 3 ? values[2] : null;
            Output0Buffer.Column4 = values.Count >= 4 ? values[3] : null;
            Output0Buffer.Column5 = values.Count >= 5 ? values[4] : null;
            Output0Buffer.Column6 = values.Count >= 6 ? values[5] : null;
        }
    }
}
]]></arrayElement>
