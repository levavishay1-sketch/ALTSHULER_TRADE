                        <arrayElement
                          dataType="System.String"><![CDATA[using System.Collections.Generic;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    List<string> warnings = new List<string>();

    public override void PreExecute()
    {
        base.PreExecute();
    }

    public override void PostExecute()
    {
        base.PostExecute();
        if (warnings.Count > 0)
        {
            string warningsLog = Variables.ETLWarningsMessageBlock;
            Variables.ETLWarningsMessageBlock = string.IsNullOrWhiteSpace(warningsLog) ?
                string.Join(",", warnings) : $"{warningsLog},{ string.Join(",", warnings)}";
        }
    }

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        string dataFlowName = Variables.DataFlowName;
        string recordId = null;
        string warningMessage = Row.ErrorMessage_IsNull ? string.Empty : Row.ErrorMessage.Replace('"', ' ').Replace(':', ' ');
        string recordKey = Row.ExternalIdentifier_IsNull ? string.Empty : Row.ExternalIdentifier;
        int? errorCode = null;
        if (!Row.ErrorCode_IsNull)
        {
            errorCode = Row.ErrorCode;
        };
        string warning = $"{{\"DataFlowName\":\"{dataFlowName}\",\"RecordId\":\"{recordId}\",\"RecordKey\":\"{recordKey}\",\"WarningMessage\":\"{warningMessage}\",\"WarningLevel\":{Row.WarningLevel},\"ErrorCode\":{errorCode}}}";
        warnings.Add(warning);
    }
}
]]></arrayElement>
