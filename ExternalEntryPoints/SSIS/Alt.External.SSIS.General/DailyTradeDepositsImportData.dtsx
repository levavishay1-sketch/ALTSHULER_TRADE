          <ProjectItem
            Name="ScriptMain.cs"
            Encoding="UTF8"><![CDATA[namespace ST_dbdbf8bcbec24ad09557b7f5db09747c
{
    [Microsoft.SqlServer.Dts.Tasks.ScriptTask.SSISScriptTaskEntryPointAttribute]
    public partial class ScriptMain : Microsoft.SqlServer.Dts.Tasks.ScriptTask.VSTARTScriptObjectModelBase
    {
        public void Main()
        {
            this.CreateLogMassage();

            Dts.TaskResult = (int)ScriptResults.Success;
        }

        private void CreateLogMassage()
        {
            string description = Dts.Variables["User::DepositsImportETLDescription"].Value.ToString();
            string counters = Dts.Variables["User::ETLCountersMessageBlock"].Value.ToString();
            string warnings = Dts.Variables["User::ETLWarningsMessageBlock"].Value.ToString();

            string log = $"{{\"description\":\"{description}\",\"counters\":[{counters}],\"warnings\":[{warnings}]}}";

            if (log.Length > 500000)
            {
                description += "The Length of the execution result exceeded the maximun allowd length. For more details see error log file.";
                log = $"{{\"description\":\"{description}\",\"counters\":[{counters}]}}";

                Dts.Variables["User::IsExceededLogLength"].Value = true;
            }

            Dts.Variables["User::ETLlLog"].Value = log;
        }

        #region ScriptResults declaration
        /// <summary>
        /// This enum provides a convenient shorthand within the scope of this class for setting the
        /// result of the script.
        /// 
        /// This code was generated automatically.
        /// </summary>
        enum ScriptResults
        {
            Success = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Success,
            Failure = Microsoft.SqlServer.Dts.Runtime.DTSExecResult.Failure
        };
        #endregion
    }
}]]></ProjectItem>
