                    <arrayElement
                      dataType="System.String"><![CDATA[using Microsoft.SqlServer.Dts.Pipeline;
using System;
using System.Collections.Generic;

[Microsoft.SqlServer.Dts.Pipeline.SSISScriptComponentEntryPointAttribute]
public class ScriptMain : UserComponent
{
    Dictionary<string, string> parameters;

    public override void PreExecute()
    {
        base.PreExecute();
        parameters = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    }

    public override void PostExecute()
    {
        base.PostExecute();
        for (int i = 0; i < ReadWriteVariables.Count; i++)
        {
            string variableName = ReadWriteVariables[i].QualifiedName.Replace("User::", "");
            if (parameters.ContainsKey(variableName))
                ReadWriteVariables[variableName].Value = parameters[variableName];
            else
                throw new Exception(string.Concat("The Variable '", variableName, "' was not found in global parameters"));
        }
    }

    public override void Input0_ProcessInputRow(Input0Buffer Row)
    {
        string value = this.BlobColumnToString(Row.altvalue);
        parameters.Add(Row.altname, value);
    }
    string BlobColumnToString(BlobColumn blobColumn)
    {
        if (blobColumn.IsNull)
            return string.Empty;

        var blobLength = Convert.ToInt32(blobColumn.Length);
        var blobData = blobColumn.GetBlobData(0, blobLength);
        var stringData = System.Text.Encoding.Unicode.GetString(blobData);

        return stringData;
    }
}
]]></arrayElement>
