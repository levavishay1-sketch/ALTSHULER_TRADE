                  description="OLE DB Source"
                  name="Get Portfolios"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT portfolio.[account]
      ,[account_name] as alt_displayname
      ,[account_num_name] as alt_name
      ,[account_type] as alt_accounttypecode
      ,[account_type_union] as alt_accounttypesubcode
      ,[tase_encripted_id] as alt_idtaseencripted
      ,[is_default_account] as alt_defultaccountbit
      ,[is_connected_account] as alt_connectedaccountbit
      ,[is_pending] as alt_pendingbit
      ,[is_tax_calc_ignore] as alt_withholdingtaxexemptionbit
      ,[is_managed] as alt_managedaccountbit
      ,[is_active]
	  ,[is_at_risk] as alt_creditmonitorbit
	  ,[is_limited_accounts_list] as alt_limitedaccountlistbit
      ,[status] AS alt_shenhavstatuscode
      ,[status_reason] as alt_statusreason
      ,[create_date] as alt_opendate
      ,[close_date] as alt_closedate
      ,[is_account_lien] as alt_pledgeaccountbit
      ,[is_alt_connected_account] as alt_additionalaccountexistsataltshulerbit
      ,[risk_account_index] as alt_riskaccountindexcode
      ,[loyalty_program] as alt_loyaltyprogramcode
      ,[identification_phone_code] as alt_identificationphonecode
      ,[provision_tax_acct] as alt_provisiontaxaccountbit
      ,[is_public] as alt_publicpersonbit
      ,[public_type] as alt_publicpersonrole
      ,[is_company_employee] as alt_companyemployeebit
      ,[company_employee_type] as alt_companyemployeetype
      ,[suspended] as alt_suspendedaccountbit
      ,[start_date_tax_calc_ignore] as alt_validlyexemptfromdate
      ,[end_date_tax_calc_ignore] as alt_validlyexemptuntildate
      ,[crm_request_ref] as alt_joiningprocessnumber
      ,[information_package] as alt_informationpackagecode
      ,[is_disconnected] as alt_disconnectedbit
      ,[is_client_request_vote] as alt_votingdocumentscode
      ,[account_type_tax] as alt_accounttypetaxcode
	  ,[city_citySymbol]
      ,[street_streetSymbol]
      ,[country_iso_code] as alt_countryalpha3codeiso
      ,[zip_code] as alt_zipcode
      ,[address] as alt_address
      ,[flat_no] as alt_flatnumber
      ,[mobile_phone] as alt_mobilephone
      ,[building_no] as alt_buildingnumber
      ,[home_phone] as alt_homephone
      ,[work_phone] as alt_workphone
      ,[email] as alt_emailaddress
	  ,portfolio.[ods_updatedate] as alt_latestoperationalsystemupdatedate
	  ,portfolio.[loyalty_program] as loyalty_program
	  ,portfolio.[commission_group] as commission_group
  FROM [ODS].[Trade].[ods_account_list] as portfolio
  left JOIN
                         Trade.ods_account_list_address_details as portfolio_details ON portfolio.account = portfolio_details.account
   where Dateadd(dd, 0, datediff(dd, 0,portfolio.[ods_updatedate])) &gt;= Dateadd(dd, 0, datediff(dd, Convert(int,?),GETDATE()))
   or Dateadd(dd, 0, datediff(dd, 0,portfolio_details.[ods_updatedate])) &gt;= Dateadd(dd, 0, datediff(dd, Convert(int,?),GETDATE()))

   order by portfolio.[account]</property>
