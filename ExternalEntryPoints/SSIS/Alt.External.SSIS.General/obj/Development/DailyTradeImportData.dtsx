        <ExpressionTask
          Expression="@[User::ErrorLogFileFullPath] =  @[User::ErrorLogFilePath] + &quot;\\&quot;+ @[User::ErrorLogFilleName]+&quot;_&quot; +&#xA;RIGHT(&quot;0&quot; + (DT_WSTR,2)DAY(GETDATE()), 2) + RIGHT(&quot;0&quot; + (DT_WSTR,2)MONTH(GETDATE()), 2)+(DT_WSTR,4)YEAR(GETDATE()) +&quot;_&quot;+RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;hh&quot;, GETDATE()), 2) + RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;mi&quot;, GETDATE()), 2) + RIGHT(&quot;0&quot; + (DT_WSTR,2)DATEPART(&quot;ss&quot;, GETDATE()), 2)+ &quot;.csv&quot;" />
