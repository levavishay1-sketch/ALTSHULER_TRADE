                <component
                  refId="Package\Handle AccountHolder Import Data\Upsert AccountHolders\Get AccountHolders"
                  componentClassID="Microsoft.OLEDBSource"
                  contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
                  description="OLE DB Source"
                  name="Get AccountHolders"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset"></property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=15.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT        accountHolder.account, 
accountHolder.is_main_owner AS alt_mainaccountholderbit, 
accountHolder.relation_type AS alt_accountholdertypecode, 
accountHolder.related_id, 
adressDetails.city_city_symbol, 
adressDetails.street_street_symbol, 
adressDetails.country_iso_code, 
adressDetails.home_phone AS alt_homephone, 
adressDetails.work_phone AS alt_workphone, 
adressDetails.email AS alt_email, 
adressDetails.zip_code AS alt_postalcode, 
adressDetails.address AS alt_address, 
adressDetails.mobile_phone AS alt_mobilephone, 
adressDetails.building_no AS alt_housenumber, 
adressDetails.flat_no AS alt_flatnumber, 
details.first_name AS alt_firstname, 
details.last_name AS alt_lastname, 
details.first_name_english AS alt_firstnameeng, 
details.last_name_english AS alt_lastnameeng, 
details.date_of_birth AS alt_birthdate, 
details.country_of_birth, 
details.gender AS alt_gendercode, 
details.marital_status AS alt_maritalstatuscode, 
details.tax_countries AS alt_residencefortaxpurposes, 
details.id_type AS alt_identificationtypecode, 
details.id_no AS alt_identificationnumber, 
details.issuing_country , details.issue_date AS alt_idissuedate, 
details.identification_method AS alt_performverificationcode, 
details.is_marketing_data_approval AS alt_allowmarketingcontentbit, 
details.is_active, details.id_type_sec AS alt_secondidentificationtypecode, 
details.sec_id_no AS alt_secondaryidentificationnumber, 
details.sec_issuing_country, 
details.sec_issue_date AS alt_secondaryidissueddate, 
details.accpet_credit_monitor_report AS alt_creditreportcustomerapprovalbit, 
details.prononpro AS alt_usercharacteristiccode, 
details.trade1_acct AS alt_usernametrade, 
details.is_deceased AS alt_deceasedbit, 
accountHolder.ods_updatedate as accountHolderUpdateDate,
details.ods_updatedate as detailsUpdateDate

FROM            Trade.ods_account_related AS accountHolder LEFT OUTER JOIN
                         Trade.ods_account_related_details_address_details AS adressDetails ON accountHolder.related_id = adressDetails.related_id LEFT OUTER JOIN
                         Trade.ods_account_related_details AS details ON accountHolder.related_id = details.related_id
WHERE        (DATEADD(dd, 0, DATEDIFF(dd, 0, accountHolder.ods_updatedate)) &gt;= DATEADD(dd, 0, DATEDIFF(dd, CONVERT(int, ?), GETDATE()))) OR
                         (DATEADD(dd, 0, DATEDIFF(dd, 0, adressDetails.ods_updatedate)) &gt;= DATEADD(dd, 0, DATEDIFF(dd, CONVERT(int, ?), GETDATE()))) OR
                         (DATEADD(dd, 0, DATEDIFF(dd, 0, details.ods_updatedate)) &gt;= DATEADD(dd, 0, DATEDIFF(dd, CONVERT(int, ?), GETDATE())))</property>
                    <property
                      dataType="System.String"
